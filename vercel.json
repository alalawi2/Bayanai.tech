{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/assets/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    },
    {
      "source": "/assets/(scenes|screens|logos)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/links(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/links/bayan-ai.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Bayan-AI.vcf\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/solutions",
      "destination": "/solutions/index.html"
    },
    {
      "source": "/solutions/bayan",
      "destination": "/solutions/bayan/index.html"
    },
    {
      "source": "/solutions/medad",
      "destination": "/solutions/medad/index.html"
    },
    {
      "source": "/solutions/preop",
      "destination": "/solutions/preop/index.html"
    },
    {
      "source": "/solutions/journalready",
      "destination": "/solutions/journalready/index.html"
    },
    {
      "source": "/solutions/smartrota",
      "destination": "/solutions/smartrota/index.html"
    },
    {
      "source": "/solutions/ohealth",
      "destination": "/solutions/ohealth/index.html"
    },
    {
      "source": "/solutions/olearn",
      "destination": "/solutions/olearn/index.html"
    },
    {
      "source": "/solutions/wardwise",
      "destination": "/solutions/wardwise/index.html"
    },
    {
      "source": "/links",
      "destination": "/links/index.html"
    },
    {
      "source": "/links/about",
      "destination": "/links/about/index.html"
    },
    {
      "source": "/links/contact",
      "destination": "/links/contact/index.html"
    },
    {
      "source": "/links/socials",
      "destination": "/links/socials/index.html"
    }
  ]
}
